#!/bin/bash
# agent-notify: set up webhook targets for the Orca "Orca Notify" plugin (xinnyu.agent-notify).
#   agent-notify add-target <name> <url> [--default] [--format generic|slack|discord] [--no-key]
#       Reads the bearer key from stdin (hidden prompt when interactive; empty = no key).
#   agent-notify remove-target <name>   Remove a target and its stored key.
#   agent-notify remove-key <name>      Delete a key file that has not been imported yet.
#   agent-notify status                 Show config (URLs redacted) and pending changes. Never prints keys.
# Changes apply the next time Orca starts the plugin: on the next agent event, or when you run
# "Orca Notify: Send test event" / "Show status" from the command palette (Cmd+J).
set -euo pipefail
D="$HOME/.orca-notify"; P="$D/pending"; K="$D/keys"
umask 077; mkdir -p "$P" "$K"; chmod 700 "$D" "$P" "$K"
usage() { sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-2}"; }
die() { echo "agent-notify: $*" >&2; exit 2; }
valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || die "invalid name '$1' (letters, digits, - and _ only)"; }
redact() { sed -E 's#(https?://[^/"?]+)[^"]*#\1/…#g'; }
next_order() { printf '%s%03d' "$(date +%s)" "$(ls "$P" 2>/dev/null | grep -c . || true)"; }
clear_pending() { rm -f "$P/$1".url "$P/$1".format "$P/$1".default "$P/$1".nokey "$P/$1".remove "$P/$1".order; }
hint() { echo "Applies when Orca next starts the plugin (next agent event, or Cmd+J → 'Orca Notify: Send test event'). Check with: agent-notify status"; }

case "${1:-}" in
  -h|--help|help) usage 0 ;;
  add-target)
    [ $# -ge 3 ] || usage
    name="$2"; url="$3"; shift 3; valid_name "$name"
    [[ "$url" =~ ^https?:// ]] || die "url must start with https:// (or http://)"
    def=0; fmt=""; nokey=0
    while [ $# -gt 0 ]; do case "$1" in
      --default) def=1; shift;;
      --format) [ $# -ge 2 ] || die "--format needs a value: generic, slack or discord"
                case "$2" in generic|slack|discord) fmt="$2";; *) die "unknown format '$2' (use generic, slack or discord)";; esac; shift 2;;
      --no-key) nokey=1; shift;;
      -h|--help) usage 0;;
      *) die "unknown option '$1'";; esac; done
    key=""
    if [ $nokey = 0 ]; then
      if [ -t 0 ]; then printf 'Bearer key for %s (Enter for none): ' "$name" >&2; IFS= read -rs key || true; echo >&2
      else IFS= read -r key || true; fi
    fi
    clear_pending "$name"
    if [ -n "$key" ]; then printf '%s' "$key" > "$K/$name.key"; chmod 600 "$K/$name.key"; else nokey=1; rm -f "$K/$name.key"; fi
    unset key
    [ -n "$fmt" ] && printf '%s' "$fmt" > "$P/$name.format"
    [ $def = 1 ] && : > "$P/$name.default"
    [ $nokey = 1 ] && : > "$P/$name.nokey"
    next_order > "$P/$name.order"
    printf '%s' "$url" > "$P/$name.url"
    echo "Queued target '$name'$([ $nokey = 1 ] && echo ' (no key)')$([ $def = 1 ] && echo ' as default')."
    hint ;;
  remove-target)
    [ $# -ge 2 ] || usage; valid_name "$2"
    clear_pending "$2"; rm -f "$K/$2.key"; next_order > "$P/$2.order"; : > "$P/$2.remove"
    echo "Queued removal of target '$2' (its stored key is deleted too)."; hint ;;
  remove-key)
    [ $# -ge 2 ] || usage; valid_name "$2"
    if [ -e "$K/$2.key" ]; then rm -f "$K/$2.key"; echo "Removed pending key file for '$2'."
    else echo "No pending key file for '$2' (imported keys live in Orca's vault; use remove-target)."; fi ;;
  status)
    echo "config: $D/config.json"
    if [ -f "$D/config.json" ]; then redact < "$D/config.json"; else echo "(not created yet; the plugin creates it on first run)"; fi
    echo "pending: $(ls "$P" 2>/dev/null | grep -E '\.(url|remove)$' | tr '\n' ' ')"
    echo "keys waiting for import: $(ls "$K" 2>/dev/null | sed 's/\.key$//' | tr '\n' ' ')" ;;
  *) usage ;;
esac
